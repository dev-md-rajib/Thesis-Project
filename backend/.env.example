# =========================================================
# AI Interview & Hiring Platform - Backend Environment Variables
# =========================================================

# Node Environment ('production' or 'development')
NODE_ENV=production

# Port for HTTP & WebSocket server (Render/Railway/Heroku auto-sets PORT)
PORT=5000

# MongoDB Connection String (MongoDB Atlas)
MONGODB_URI=mongodb+srv://username:password@cluster0.hywqh.mongodb.net/?retryWrites=true&w=majority&appName=Cluster0

# JWT Authentication Secret & Expiration
JWT_SECRET=replace_with_a_long_random_secure_secret_key_here
JWT_EXPIRE=7d

# Google Gemini AI API Key (from Google AI Studio: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=your_gemini_api_key_here

# Frontend Application URL(s) for CORS and Deep Links
# Can be a single URL or multiple comma-separated URLs
CLIENT_URL=https://your-frontend-app.vercel.app,http://localhost:5173

# Local File Uploads Directory
UPLOAD_PATH=uploads/

# ---------------------------------------------------------
# Optional: Zoom Server-to-Server OAuth Integration
# (Only needed if utilizing external Zoom meeting creation)
# ---------------------------------------------------------
ZOOM_ACCOUNT_ID=
ZOOM_CLIENT_ID=
ZOOM_CLIENT_SECRET=
ZOOM_SECRET_TOKEN=
