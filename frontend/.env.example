# Backend API & WebSocket Server URL (e.g. https://your-backend-api.onrender.com)
# Leave empty or omit if hosting both frontend & backend on the same domain/proxy
VITE_API_BASE_URL=http://localhost:5000

# (Optional) Public download link for the Desktop Interview Tracker application (.exe / installer)
VITE_TRACKER_DOWNLOAD_URL=https://drive.google.com/drive/folders/your_tracker_download_link
